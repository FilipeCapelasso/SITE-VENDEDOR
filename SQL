async function upF(el){try{toast('Enviando fotos...');for(const f of el.files)E.fotos.push(await up(f));fm()}catch(e){toast('Erro: '+e.message)}}
async function upVid(el){try{toast('Enviando vídeo...');E.video_url=await up(el.files[0]);fm();toast('Vídeo enviado')}catch(e){toast('Erro: '+e.message)}}
async function saveM(){
  if(!E.nome.trim())return toast('Informe o nome da moto');
  const{error}=await sb.from('motos').upsert(E);if(error)return toast('Erro: '+error.message);
