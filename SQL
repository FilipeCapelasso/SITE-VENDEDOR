addEventListener('popstate',()=>{$('#modal').style.display='none'});
addEventListener('keydown',e=>{if(e.key==='Escape')closeM()});
(()=>{let y=0,t=0;addEventListener('scroll',()=>{if(t)return;t=requestAnimationFrame(()=>{t=0;const b=document.querySelector('.bar');if(!b)return;const c=scrollY,d=c-y;
  if(innerWidth<720){if(d>8&&c>420)b.classList.add('hd');else if(d<-8||c<200)b.classList.remove('hd')}else b.classList.remove('hd');if(Math.abs(d)>8)y=c})},{passive:true})})();
