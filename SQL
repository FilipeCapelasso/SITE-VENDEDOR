-- (o cliente NÃO grava direto na tabela: só pela função abaixo)

create or replace function public.registrar_pedido_chat(p jsonb) returns void
language plpgsql security definer set search_path = public as $$
declare v_id uuid;
begin
  if coalesce(p->>'id','') !~* '^[0-9a-f-]{36}$' or coalesce(p->>'telefone','') = '' then return; end if;
  v_id := (p->>'id')::uuid;
  insert into public.pedidos_chat (id, completo, moto_id, moto_nome, pagamento, nome, nome_completo, telefone, cpf,
    nascimento, entrada, parcela, forma_pagamento, troca, parcelamento_cartao, habilitacao, mensagem, dados)
  values (v_id, coalesce((p->>'completo')::boolean, false),
    case when coalesce(p->>'moto_id','') ~* '^[0-9a-f-]{36}$' then (p->>'moto_id')::uuid end,
    left(p->>'moto_nome',200), left(p->>'pagamento',30), left(p->>'nome',200), left(p->>'nome_completo',200),
    left(p->>'telefone',30), left(p->>'cpf',20), left(p->>'nascimento',20), left(p->>'entrada',60),
    left(p->>'parcela',80), left(p->>'forma_pagamento',60), left(p->>'troca',200), left(p->>'parcelamento_cartao',60),
    left(p->>'habilitacao',60), left(p->>'mensagem',3000), p)
  on conflict (id) do update set
    updated_at = now(),
    completo = pedidos_chat.completo or excluded.completo,
    moto_id = coalesce(excluded.moto_id, pedidos_chat.moto_id),
    moto_nome = coalesce(excluded.moto_nome, pedidos_chat.moto_nome),
    pagamento = coalesce(excluded.pagamento, pedidos_chat.pagamento),
    nome = coalesce(excluded.nome, pedidos_chat.nome),
    nome_completo = coalesce(excluded.nome_completo, pedidos_chat.nome_completo),
    telefone = coalesce(excluded.telefone, pedidos_chat.telefone),
    cpf = coalesce(excluded.cpf, pedidos_chat.cpf),
    nascimento = coalesce(excluded.nascimento, pedidos_chat.nascimento),
    entrada = coalesce(excluded.entrada, pedidos_chat.entrada),
    parcela = coalesce(excluded.parcela, pedidos_chat.parcela),
    forma_pagamento = coalesce(excluded.forma_pagamento, pedidos_chat.forma_pagamento),
    troca = coalesce(excluded.troca, pedidos_chat.troca),
    parcelamento_cartao = coalesce(excluded.parcelamento_cartao, pedidos_chat.parcelamento_cartao),
    habilitacao = coalesce(excluded.habilitacao, pedidos_chat.habilitacao),
    mensagem = coalesce(excluded.mensagem, pedidos_chat.mensagem),
    dados = pedidos_chat.dados || excluded.dados;
end $$;
grant execute on function public.registrar_pedido_chat(jsonb) to anon, authenticated;

-- Aviso no Telegram quando o cliente TERMINA o chat (o token fica só no banco)
create or replace function public.notificar_pedido_chat() returns trigger
language plpgsql security definer set search_path = public, extensions as $$
declare t text; c text; msg text;
begin
  if not new.completo then return new; end if;
  if tg_op = 'UPDATE' and old.completo then return new; end if;
  select valor into t from public.config_privada where chave = 'telegram_token';
  select valor into c from public.config_privada where chave = 'telegram_chat_id';
  if t is null or c is null then return new; end if;
  msg := concat_ws(E'\n',
    '🏍️ NOVO PEDIDO NO SITE', '',
    'Moto: ' || coalesce(new.moto_nome,'-'),
    'Modalidade: ' || upper(coalesce(new.pagamento,'-')),
    case when new.entrada is not null then 'Entrada: ' || new.entrada end,
    case when new.parcela is not null then 'Parcela desejada: ' || new.parcela end,
    case when new.forma_pagamento is not null then 'Forma de pagamento: ' || new.forma_pagamento end,
    case when new.troca is not null then 'Moto na troca: ' || new.troca end,
    case when new.parcelamento_cartao is not null then 'Parcelamento: ' || new.parcelamento_cartao end,
    '',
    'Cliente: ' || coalesce(new.nome_completo, new.nome, '-'),
    'WhatsApp: ' || coalesce(new.telefone,'-'),
    case when new.cpf is not null then 'CPF: ' || new.cpf end,
    case when new.nascimento is not null then 'Nascimento: ' || new.nascimento end,
    case when new.habilitacao is not null then 'Habilitação: ' || new.habilitacao end,
    '',
    'Chamar: https://wa.me/' || regexp_replace(coalesce(new.telefone,''), '\D', '', 'g'),
    'Data: ' || to_char(new.created_at at time zone 'America/Rio_Branco', 'DD/MM/YYYY HH24:MI'));
  begin
    perform net.http_post(
      url := 'https://api.telegram.org/bot' || t || '/sendMessage',
      headers := '{"Content-Type":"application/json"}'::jsonb,
      body := jsonb_build_object('chat_id', c, 'text', msg, 'disable_web_page_preview', true));
  exception when others then null;  -- falha no Telegram nunca bloqueia o pedido
  end;
  return new;
end $$;

drop trigger if exists trg_notificar_pedido on public.pedidos_chat;
create trigger trg_notificar_pedido after insert or update of completo on public.pedidos_chat
  for each row execute function public.notificar_pedido_chat();

