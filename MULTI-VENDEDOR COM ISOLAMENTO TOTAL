-- ---------- CATÁLOGO MODELO: todo vendedor novo já nasce com as motos/motores prontos ----------
-- Copia TODAS as colunas da tabela motos (nome, foto, descrição, preço, planos de consórcio, categoria, ordem...),
-- mesmo as que você adicionar no futuro. Cada vendedor recebe linhas NOVAS e independentes (editar não afeta o modelo).
-- ---------------------------------------------------------------------------------------------
--  CONSÓRCIOS / PLANOS PADRÃO  (fonte: vendedor modelo = plataforma_config.vendedor_modelo, hoje "shayron")
--  Nunca altera o modelo. Só preenche o que está VAZIO no vendedor de destino (personalizações ficam intactas).
-- ---------------------------------------------------------------------------------------------

-- quantidade de planos de um jsonb (0 se vazio/nulo/não-array)
create or replace function public.plano_qtd(j jsonb) returns int language sql immutable as $$
  select case when jsonb_typeof(j) = 'array' then jsonb_array_length(j) else 0 end $$;

-- colunas copiáveis de uma tabela (ignora PK com default, identity, geradas e as listadas em p_excl)
create or replace function public.cols_copia(p_rel regclass, p_excl text[]) returns text[]
language sql stable set search_path = public as $$
  select coalesce(array_agg(a.attname::text order by a.attnum), '{}'::text[])
    from pg_attribute a
   where a.attrelid = p_rel and a.attnum > 0 and not a.attisdropped
     and a.attgenerated = '' and a.attidentity = ''
     and a.attname::text <> all (p_excl)
     and not (a.atthasdef and a.attnum = any (array(select unnest(conkey) from pg_constraint where conrelid = p_rel and contype = 'p'))) $$;

create or replace function public.carregar_planos_padrao(p_slug text, p_substituir boolean default false) returns text
language plpgsql security definer set search_path = public as $$
declare
  modelo text; mid uuid; did uuid;
  n_upd int := 0; n_pres int := 0; n_falta int := 0; n int; n_std int := 0;
  fk record; tb record; colunas text[]; hv boolean; ins text; sel text; msg text := '';
  sistema constant text[] := array['vendedores','vendedor_segredos','motos','leads','fichas','contratos','pedidos_chat','bot_sessoes','bot_log','plataforma_config','donos'];
begin
  select valor into modelo from public.plataforma_config where chave = 'vendedor_modelo';
  if modelo is null then return 'Sem vendedor modelo definido (use /modelo slug).'; end if;
  select id into mid from public.vendedores where slug = modelo;
  if mid is null then return format('O vendedor modelo "%s" não existe mais.', modelo); end if;
  select id into did from public.vendedores where slug = lower(btrim(p_slug));
  if did is null then raise exception 'Slug "%" não existe.', p_slug; end if;
  if did = mid then return 'Esse é o próprio vendedor modelo (nada a fazer).'; end if;

  -- 0) tabela de planos padrão (planos_padrao): preenche as motos sem plano, pelo nome
  n_std := public.aplicar_planos_padrao(p_slug, p_substituir, false);

  -- A) planos que ficam dentro da própria moto (motos.planos / emplacamento / preco), casando pelo NOME da moto
  if not p_substituir then
    select count(*) into n_pres from public.motos t
     where t.vendedor_id = did and public.plano_qtd(t.planos) > 0
       and exists (select 1 from public.motos m where m.vendedor_id = mid and public.plano_qtd(m.planos) > 0
                    and upper(btrim(m.nome)) = upper(btrim(t.nome)));
  end if;
  with par as (
    select distinct on (t.id) t.id as tid, m.planos, m.emplacamento, m.preco
      from public.motos t join public.motos m on upper(btrim(m.nome)) = upper(btrim(t.nome))
     where t.vendedor_id = did and m.vendedor_id = mid and public.plano_qtd(m.planos) > 0
     order by t.id, m.ordem, m.id)
  update public.motos t set
         planos = par.planos,
         emplacamento = case when p_substituir or coalesce(btrim(t.emplacamento), '') = '' then coalesce(par.emplacamento, t.emplacamento) else t.emplacamento end,
         preco = case when p_substituir or coalesce(t.preco, 0) = 0 then coalesce(par.preco, t.preco) else t.preco end
    from par
   where t.id = par.tid and (p_substituir or public.plano_qtd(t.planos) = 0);
  get diagnostics n_upd = row_count;

  select count(*) into n_falta from public.motos m
   where m.vendedor_id = mid and not exists (select 1 from public.motos t where t.vendedor_id = did
         and upper(btrim(t.nome)) = upper(btrim(m.nome)));

  msg := format('planos da tabela padrão aplicados: %s; planos copiados do modelo: %s; já tinham plano (preservados): %s', n_std, n_upd, n_pres);
  if n_falta > 0 then msg := msg || format('; %s moto(s) do modelo ainda não existem nesse vendedor', n_falta); end if;

  -- B) tabelas filhas ligadas à moto por chave estrangeira (ex.: uma tabela de planos com moto_id)
  for fk in
    select c.conrelid as relid, cl.relname as tbl, a.attname::text as col
      from pg_constraint c
      join pg_class cl on cl.oid = c.conrelid
      join pg_attribute a on a.attrelid = c.conrelid and a.attnum = c.conkey[1]
     where c.contype = 'f' and c.confrelid = 'public.motos'::regclass and array_length(c.conkey, 1) = 1
       and cl.relnamespace = 'public'::regnamespace and cl.relname <> all (sistema)
  loop
    begin
      colunas := public.cols_copia(fk.relid, array[fk.col, 'vendedor_id', 'created_at', 'updated_at']);
      hv := exists (select 1 from pg_attribute where attrelid = fk.relid and attname = 'vendedor_id' and not attisdropped);
      ins := quote_ident(fk.col) || case when hv then ', vendedor_id' else '' end
             || (select coalesce(', ' || string_agg(quote_ident(x), ', '), '') from unnest(colunas) x);
      sel := 'p.tid' || case when hv then ', $2' else '' end
             || (select coalesce(', ' || string_agg('s.' || quote_ident(x), ', '), '') from unnest(colunas) x);
      if p_substituir then
        execute format('delete from public.%I where %I in (select id from public.motos where vendedor_id = $1)', fk.tbl, fk.col) using did;
      end if;
      execute format($f$
        insert into public.%1$I (%2$s)
        select %3$s from public.%1$I s
          join (select distinct on (t.id) t.id as tid, m.id as mid_moto
                  from public.motos t join public.motos m on upper(btrim(m.nome)) = upper(btrim(t.nome))
                 where t.vendedor_id = $2 and m.vendedor_id = $1
                 order by t.id, m.ordem, m.id) p on p.mid_moto = s.%4$I
         where not exists (select 1 from public.%1$I x where x.%4$I = p.tid)$f$, fk.tbl, ins, sel, fk.col) using mid, did;
      get diagnostics n = row_count;
      msg := msg || format('; tabela %s: %s linha(s) copiada(s)', fk.tbl, n);
    exception when others then
      msg := msg || format('; tabela %s: ERRO (%s)', fk.tbl, sqlerrm);
    end;
  end loop;

  -- C) tabelas de consórcio por vendedor (têm vendedor_id, nome de consórcio/plano) — NUNCA tabelas de clientes
  for tb in
    select cl.oid as relid, cl.relname as tbl from pg_class cl
     where cl.relnamespace = 'public'::regnamespace and cl.relkind = 'r' and cl.relname <> all (sistema)
       and cl.relname ~* '(consorc|plano|tabela|credito|parcela|taxa)'
       and cl.relname !~* '(cliente|venda|lead|pedido|ficha|contrato|simul|proposta|cpf)'
       and exists (select 1 from pg_attribute where attrelid = cl.oid and attname = 'vendedor_id' and not attisdropped)
       and not exists (select 1 from pg_constraint c where c.conrelid = cl.oid and c.contype = 'f' and c.confrelid = 'public.motos'::regclass)
  loop
    begin
      if p_substituir then
        execute format('delete from public.%I where vendedor_id = $1', tb.tbl) using did;
      else
        execute format('select count(*) from public.%I where vendedor_id = $1', tb.tbl) into n using did;
        if n > 0 then msg := msg || format('; tabela %s: já tinha %s linha(s) (preservadas)', tb.tbl, n); continue; end if;
      end if;
      colunas := public.cols_copia(tb.relid, array['vendedor_id', 'created_at', 'updated_at']);
      execute format('insert into public.%1$I (vendedor_id%2$s) select $2%3$s from public.%1$I s where s.vendedor_id = $1', tb.tbl,
        (select coalesce(', ' || string_agg(quote_ident(x), ', '), '') from unnest(colunas) x),
        (select coalesce(', ' || string_agg('s.' || quote_ident(x), ', '), '') from unnest(colunas) x)) using mid, did;
      get diagnostics n = row_count;
      msg := msg || format('; tabela %s: %s linha(s) copiada(s)', tb.tbl, n);
    exception when others then
      msg := msg || format('; tabela %s: ERRO (%s)', tb.tbl, sqlerrm);
    end;
  end loop;

  return format('Planos padrão (modelo %s) → %s: %s.', modelo, lower(btrim(p_slug)), msg);
end $$;

-- todos os vendedores já criados (só preenche o que está vazio)
create or replace function public.carregar_planos_padrao_todos() returns text
language plpgsql security definer set search_path = public as $$
declare modelo text; r record; txt text := ''; k int := 0;
begin
  select valor into modelo from public.plataforma_config where chave = 'vendedor_modelo';
  if modelo is null then return 'Sem vendedor modelo definido (use /modelo slug).'; end if;
  for r in select slug from public.vendedores where slug <> modelo order by created_at loop
    txt := txt || E'\n' || public.carregar_planos_padrao(r.slug, false); k := k + 1;
  end loop;
  return case when k = 0 then 'Nenhum vendedor além do modelo.' else k || ' vendedor(es):' || txt end;
end $$;

-- botão do painel: o vendedor logado carrega os planos padrão SÓ no próprio cadastro (não sobrescreve o que ele já tem)
create or replace function public.carregar_meus_planos(p_vendedor uuid) returns text
language plpgsql security definer set search_path = public as $$
declare s text;
begin
  if not public.pode_gerir(p_vendedor) then raise exception 'Sem permissão para este vendedor'; end if;
  select slug into s from public.vendedores where id = p_vendedor;
  return public.carregar_planos_padrao(s, false);
end $$;

-- OPCIONAL: liga RLS nas tabelas filhas de moto que estiverem SEM proteção (para um vendedor não editar plano de outro)
create or replace function public.proteger_tabelas_consorcio() returns text
language plpgsql security definer set search_path = public as $$
declare fk record; msg text := '';
begin
  for fk in
    select cl.relname as tbl, a.attname::text as col, cl.relrowsecurity as rls
      from pg_constraint c join pg_class cl on cl.oid = c.conrelid
      join pg_attribute a on a.attrelid = c.conrelid and a.attnum = c.conkey[1]
     where c.contype = 'f' and c.confrelid = 'public.motos'::regclass and array_length(c.conkey, 1) = 1
       and cl.relnamespace = 'public'::regnamespace
       and cl.relname <> all (array['leads','fichas','contratos','pedidos_chat'])
  loop
    if fk.rls then msg := msg || format('%s: já tinha RLS (não mexi). ', fk.tbl); continue; end if;
    execute format('alter table public.%I enable row level security', fk.tbl);
    execute format('create policy c_pub_sel on public.%I for select to anon, authenticated using (exists (select 1 from public.motos m where m.id = %I))', fk.tbl, fk.col);
    execute format('create policy c_ger_ins on public.%I for insert to authenticated with check (exists (select 1 from public.motos m where m.id = %I and public.pode_gerir(m.vendedor_id)))', fk.tbl, fk.col);
    execute format('create policy c_ger_upd on public.%I for update to authenticated using (exists (select 1 from public.motos m where m.id = %I and public.pode_gerir(m.vendedor_id))) with check (exists (select 1 from public.motos m where m.id = %I and public.pode_gerir(m.vendedor_id)))', fk.tbl, fk.col, fk.col);
    execute format('create policy c_ger_del on public.%I for delete to authenticated using (exists (select 1 from public.motos m where m.id = %I and public.pode_gerir(m.vendedor_id)))', fk.tbl, fk.col);
    msg := msg || format('%s: RLS ligado. ', fk.tbl);
  end loop;
  return coalesce(nullif(msg, ''), 'Nenhuma tabela filha de moto encontrada.');
end $$;

