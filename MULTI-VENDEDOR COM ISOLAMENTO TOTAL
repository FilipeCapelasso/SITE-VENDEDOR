-- true se TODOS os planos atuais existem na tabela padrão (tolerância de 1 centavo): plano incompleto, nunca personalizado
create or replace function public.plano_igual_ou_subconjunto(cur jsonb, pad jsonb) returns boolean language sql immutable as $$
  select public.plano_qtd(cur) > 0 and not exists (
    select 1 from jsonb_array_elements(cur) e
     where not exists (select 1 from jsonb_array_elements(pad) s
            where (s->>'parcelas')::numeric = (e->>'parcelas')::numeric
              and abs((s->>'valor')::numeric - (e->>'valor')::numeric) <= 0.011)) $$;

-- aplica a tabela padrão nas motos de UM vendedor.
--   padrão: só preenche moto SEM plano.
--   p_completar: também completa moto cujos planos são só um pedaço do padrão (use na carga inicial).
--   p_substituir: sobrescreve tudo que casar (cuidado: apaga personalização).
create or replace function public.aplicar_planos_padrao(p_slug text, p_substituir boolean default false, p_completar boolean default false) returns int
language plpgsql security definer set search_path = public as $$
declare did uuid; n int := 0;
begin
  select id into did from public.vendedores where slug = lower(btrim(p_slug));
  if did is null then raise exception 'Slug "%" não existe.', p_slug; end if;
  update public.motos t set
         planos = p.planos,
         emplacamento = case when p_substituir or coalesce(btrim(t.emplacamento), '') in ('', 'Com emplacamento', 'Sem emplacamento')
                             then p.emplacamento else t.emplacamento end
    from public.planos_padrao p
   where t.vendedor_id = did and public.norm_moto(t.nome) = p.nome_norm
     and (p_substituir or public.plano_qtd(t.planos) = 0
          or (p_completar and public.plano_igual_ou_subconjunto(t.planos, p.planos)))
     and (t.planos is distinct from p.planos or coalesce(t.emplacamento, '') is distinct from p.emplacamento);
  get diagnostics n = row_count;
  return n;
end $$;

-- todos os vendedores já criados (inclui o modelo)
create or replace function public.aplicar_planos_padrao_todos(p_completar boolean default true) returns text
language plpgsql security definer set search_path = public as $$
declare r record; txt text := ''; k int := 0;
begin
  for r in select slug from public.vendedores order by created_at loop
    txt := txt || E'\n' || r.slug || ': ' || public.aplicar_planos_padrao(r.slug, false, p_completar) || ' moto(s) atualizada(s)'; k := k + 1;
  end loop;
  return k || ' vendedor(es):' || txt;
end $$;

